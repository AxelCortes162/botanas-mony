# Copia este archivo como .env.local y ajusta los valores si quieres apuntar
# a otro proyecto de Firebase (por ejemplo uno de pruebas).
#
# Si no defines nada, la app usa la configuración del proyecto de producción
# que ya viene en src/lib/firebase.js. Esta configuración es pública por diseño:
# la seguridad real está en database.rules.json (solo un usuario autenticado
# puede escribir).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
